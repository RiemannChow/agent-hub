# ===== agent-hub 运行所需环境变量 =====
# 复制本文件为 .env 后填写真实值；.env 已被 .gitignore 忽略，不会进入仓库。
# Spring Boot 直接读取以下环境变量（application.yml 中以 ${VAR:default} 引用）。

# ---- 腾讯混元 Hunyuan 接入（经 LKEAP 的 Anthropic 兼容网关）----
# 必填：缺失时模型调用会鉴权失败
AGENT_MODEL_API_KEY=sk-xxxxxxxxxxxxxxxx
# 可选：默认即下方网关地址
AGENT_MODEL_BASE_URL=https://api.lkeap.cloud.tencent.com/plan/anthropic
# 可选：默认 hy4-preview
AGENT_MODEL_NAME=hy4-preview

# ---- 可选：Neo4j（oceanbase profile 使用）----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=oceanbase123

# ---- 可选：SeekDB / OceanBase JDBC 密码（默认空）----
SEEKDB_PASSWORD=

# ---- 可选：Nacos 服务注册/发现地址（A2A 智能体服务发现依赖）----
NACOS_ADDR=127.0.0.1:8848

# ---- 可选：本智能体对外可访问地址（写进 Agent Card 与 Nacos 元数据；多实例/容器部署时改为宿主 IP 或网关）----
AGENT_PUBLIC_URL=http://localhost:8080
