# ===== agent-hub 运行所需环境变量 =====
# 复制本文件为 .env 后填写真实值；.env 已被 .gitignore 忽略，不会进入仓库。
# Spring Boot 直接读取以下环境变量（application.yml 中以 ${VAR:default} 引用）。

# ---- 腾讯混元 Hunyuan 接入（经 LKEAP 的 Anthropic 兼容网关）----
# 必填：缺失时模型调用会鉴权失败
AGENT_MODEL_API_KEY=sk-xxxxxxxxxxxxxxxx
# 可选：默认即下方网关地址
AGENT_MODEL_BASE_URL=https://api.lkeap.cloud.tencent.com/plan/anthropic
# 可选：默认 hy4-preview
AGENT_MODEL_NAME=hy4-preview

# ---- 可选：兜底模型（主模型重试耗尽后仍失败时启用；留空 = 不启用）----
AGENT_FALLBACK_MODEL_NAME=
# 留空则复用上面主模型的网关与凭据
AGENT_FALLBACK_BASE_URL=
AGENT_FALLBACK_API_KEY=

# ---- 可选：执行层超时 / 重试 ----
# 整轮对话总时长上限，到点截断并给前端补一条说明（保证 SSE 一定终止）
AGENT_TURN_TIMEOUT=300s
# 单次模型调用超时与重试次数
AGENT_MODEL_TIMEOUT=120s
AGENT_MODEL_MAX_ATTEMPTS=3
# 单次工具调用超时与重试次数（默认不重试，避免有副作用的工具被重复执行）
AGENT_TOOL_TIMEOUT=30s
AGENT_TOOL_MAX_ATTEMPTS=1

# ---- 可选：SQL 守卫（LLM 生成的 SQL 下发前的静态校验）----
# 关掉等于放弃只读/白名单/LIMIT 保护，仅建议本地排障时临时关闭
AGENT_SQL_GUARD_ENABLED=true
# 单次查询最多返回行数（守卫会在外层强制包 LIMIT）
AGENT_SQL_MAX_ROWS=200
# 单条 SQL 执行超时（秒）
AGENT_SQL_QUERY_TIMEOUT_SECONDS=10

# ---- 可选：上下文窗口 / 历史摘要 ----
# 关闭后溢出窗口的老历史直接丢弃（退化为改造前的行为）
AGENT_CONTEXT_SUMMARIZE_ENABLED=true
# 注入模型的最近历史条数（不含本轮用户消息）
AGENT_CONTEXT_RECENT_MESSAGES=8
# 最近窗口的字符预算：防止一条超长消息（长表格/长贴文）挤爆上下文
AGENT_CONTEXT_RECENT_CHAR_BUDGET=6000

# ---- 可选：限流与配额（每用户）----
AGENT_QUOTA_ENABLED=true
# 同一用户同时在跑的对话轮次上限（开十个标签页不再能打爆网关）
AGENT_QUOTA_MAX_CONCURRENT=2
# 每用户每日 token 预算（自然日 0 点重置），<=0 表示不限制
AGENT_QUOTA_DAILY_TOKENS=500000

# ---- 可选：Neo4j（oceanbase profile 使用）----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=oceanbase123

# ---- 可选：SeekDB / OceanBase JDBC 密码（默认空）----
SEEKDB_PASSWORD=

# ---- 可选：Nacos 服务注册/发现地址（A2A 智能体服务发现依赖）----
NACOS_ADDR=127.0.0.1:8848

# ---- 可选：A2A 出站协作（把发现到的对端注册成模型可调用的工具）----
# Nacos 对端刷新周期（注意用 15s 这类写法，不要写成纯数字毫秒以外的时间单位混用）
AGENT_A2A_DISCOVERY_INTERVAL=15s
# 关掉后退回「只发现不协作」：对端仍可见，但模型拿不到委托工具
AGENT_A2A_CLIENT_ENABLED=true
# 对端工具名前缀：最终形如 call_agent_<serviceName>
AGENT_A2A_TOOL_PREFIX=call_agent_
# 最多注册多少个对端工具（按名称排序取前 N，保证工具集稳定）
AGENT_A2A_MAX_PEERS=5
# 单次委托超时
AGENT_A2A_CLIENT_TIMEOUT=90s
# 委托结果回填给模型的字符上限，超出截断
AGENT_A2A_MAX_RESULT_CHARS=4000
# 最大委托跳数：出站写入 metadata、入站据此拒绝过深级联，防止 A→B→A 无限 ping-pong
AGENT_A2A_MAX_DELEGATION_DEPTH=3
# 只允许委托给这些对端（Agent Card name 或 Nacos serviceName，逗号分隔；留空 = 不限制）
AGENT_A2A_ALLOWLIST=
# A2A 任务保留时长与容量上限（tasks/get / tasks/cancel 的内存索引）
AGENT_A2A_TASK_TTL=30m
AGENT_A2A_TASK_MAX_ENTRIES=2000

# ---- 可选：框架原生能力开关（都会改变模型可见的工具集/提示词，建议先评测再开）----
AGENT_NATIVE_TASK_LIST=false
AGENT_NATIVE_META_TOOL=false
AGENT_NATIVE_PENDING_TOOL_RECOVERY=false

# ---- 可选：本智能体对外可访问地址（写进 Agent Card 与 Nacos 元数据；多实例/容器部署时改为宿主 IP 或网关）----
AGENT_PUBLIC_URL=http://localhost:8080

# ---- 可选：Langfuse 可观测性（OpenTelemetry OTLP 上报）----
# 置为 true 后，每轮对话会作为一条 trace 上报；不填凭据则自动降级为不上报。
LANGFUSE_ENABLED=false
# Langfuse 项目 Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# 云端 EU（默认）/ US：https://us.cloud.langfuse.com / 自托管：http://localhost:3000
LANGFUSE_HOST=https://cloud.langfuse.com
# 需要经 Collector 或网关转发时，写完整的 OTLP/HTTP traces 地址（留空则按 LANGFUSE_HOST 推导）
LANGFUSE_OTEL_ENDPOINT=
LANGFUSE_ENVIRONMENT=local
LANGFUSE_RELEASE=1.0.0
# 是否上报 prompt / completion / 工具入参出参；生产含敏感数据时置为 false
LANGFUSE_CAPTURE_CONTENT=true
