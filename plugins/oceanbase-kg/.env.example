# Neo4j 连接（与 neo4j/docker-compose.yml 中 NEO4J_AUTH 保持一致）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=oceanbase123

# GitHub 访问令牌（可选，提升 API 配额；不填则用匿名/克隆方式）
GITHUB_TOKEN=

# 可选：LLM 关系抽取增强（默认关闭；填了才会启用）
LLM_API_KEY=
LLM_BASE_URL=https://api.lkeap.cloud.tencent.com/plan/anthropic
LLM_MODEL=hy4-preview
